# ====================================================================
# SOFRAFLOW — PRODUCTION-ORIENTED RESTAURANT ORDERING SAAS
# Environment Configuration Template
# ====================================================================

# Port and App URL
VITE_APP_NAME="SOFRAFLOW"
VITE_APP_URL="http://localhost:5173"

# --------------------------------------------------------------------
# Official WhatsApp Business Platform Cloud API (Meta)
# --------------------------------------------------------------------
# Obtain these from your Meta Developer Portal (developers.facebook.com):
# App Dashboard -> WhatsApp -> API Setup

# 1. Meta Phone Number ID (Numeric identifier for the kitchen sending number)
VITE_META_WHATSAPP_PHONE_NUMBER_ID=""

# 2. WhatsApp Business Account ID (WABA ID)
VITE_META_WHATSAPP_WABA_ID=""

# 3. Permanent System User Access Token (Requires whatsapp_business_messaging permission)
# Note: In production server deployments, store this in server-side secret stores
VITE_META_WHATSAPP_ACCESS_TOKEN=""

# 4. Registered & Approved Template Name
VITE_META_WHATSAPP_TEMPLATE_NAME="sofraflow_order_notification_v1"

# 5. Fallback Kitchen Destination Phone Number (E.164 international format, e.g. +212600123456)
VITE_DEFAULT_KITCHEN_WHATSAPP="+212661234567"

# --------------------------------------------------------------------
# Database / Backend Connection (Supabase / PostgreSQL)
# --------------------------------------------------------------------
# When connecting to cloud PostgreSQL/Supabase:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
DATABASE_URL="postgresql://postgres:password@localhost:5432/sofraflow"
