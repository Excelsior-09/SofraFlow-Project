# ====================================================================
# SOFRAFLOW — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ====================================================================

VITE_APP_NAME="SOFRAFLOW"
VITE_APP_URL="http://localhost:5173"

# --------------------------------------------------------------------
# Database / Backend Connection (Supabase / PostgreSQL)
# --------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"
DATABASE_URL="postgresql://postgres:password@localhost:5432/sofraflow"

# --------------------------------------------------------------------
# Official WhatsApp Business Platform Cloud API (Meta)
# --------------------------------------------------------------------
# Obtain these from your Meta Developer Portal (developers.facebook.com):
# App Dashboard -> WhatsApp -> API Setup
VITE_META_WHATSAPP_PHONE_NUMBER_ID=""
VITE_META_WHATSAPP_WABA_ID=""
VITE_META_WHATSAPP_ACCESS_TOKEN=""
VITE_META_WHATSAPP_TEMPLATE_NAME="sofraflow_order_notification_v1"
VITE_DEFAULT_KITCHEN_WHATSAPP="+212661234567"
